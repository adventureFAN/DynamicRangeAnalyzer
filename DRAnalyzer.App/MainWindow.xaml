<Window x:Class="DRAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Range Analyzer"
        Icon="Assets/app_icon.ico"
        Width="1100"
        Height="700"
        MinWidth="900"
        MinHeight="550"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Window.Resources>

        <Style x:Key="CenteredCellTextStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RightAlignedCellTextStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Background"
                    Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <DockPanel>

        <Menu DockPanel.Dock="Top"
              IsMainMenu="True">

            <MenuItem Header="_File">

                <MenuItem Header="_Add Files..."
                          InputGestureText="Ctrl+O"
                          IsEnabled="{Binding IsEnabled, ElementName=AddFilesButton}"
                          Click="AddFiles_Click"/>

                <MenuItem Header="Add _Folder..."
                          InputGestureText="Ctrl+Shift+O"
                          IsEnabled="{Binding IsEnabled, ElementName=AddFolderButton}"
                          Click="AddFolder_Click"/>

                <Separator/>

                <MenuItem x:Name="RemoveSelectedMenuItem"
                          Header="_Remove Selected"
                          InputGestureText="Delete"
                          IsEnabled="False"
                          Click="RemoveSelectedMenuItem_Click"/>

                <MenuItem Header="_Clear List"
                          InputGestureText="Ctrl+L"
                          IsEnabled="{Binding IsEnabled, ElementName=ClearListButton}"
                          Click="ClearListButton_Click"/>

                <Separator/>

                <MenuItem Header="E_xit"
                          InputGestureText="Alt+F4"
                          Click="ExitMenuItem_Click"/>

            </MenuItem>


            <MenuItem Header="_View">

                <MenuItem Header="_Theme">

                    <MenuItem x:Name="ThemeSystemMenuItem"
                              Header="_System"
                              IsCheckable="True"
                              Click="ThemeSystemMenuItem_Click"/>

                    <MenuItem x:Name="ThemeLightMenuItem"
                              Header="_Light"
                              IsCheckable="True"
                              Click="ThemeLightMenuItem_Click"/>

                    <MenuItem x:Name="ThemeDarkMenuItem"
                              Header="_Dark"
                              IsCheckable="True"
                              Click="ThemeDarkMenuItem_Click"/>

                </MenuItem>

                <Separator/>

                <MenuItem Header="Change _Font..."
                          Click="ChangeFontMenuItem_Click"/>

                <MenuItem Header="_Reset Font"
                          Click="ResetFontMenuItem_Click"/>

                <Separator/>

                <MenuItem Header="Reset _Table Layout"
                          Click="ResetTableLayoutMenuItem_Click"/>

            </MenuItem>


            <MenuItem Header="_Help">

                <MenuItem Header="_About..."
                          Click="AboutMenuItem_Click"/>

            </MenuItem>

        </Menu>


        <Grid Margin="20,6,20,20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button x:Name="AddFilesButton"
                            Content="Add Files"
                            Padding="16,8"
                            Margin="0,0,8,0"
                            Click="AddFiles_Click"/>

                    <Button x:Name="AddFolderButton"
                            Content="Add Folder"
                            Padding="16,8"
                            Click="AddFolder_Click"/>

                </StackPanel>

                <Button x:Name="ClearListButton"
                        Grid.Column="2"
                        Content="Clear List"
                        Padding="16,8"
                        IsEnabled="False"
                        Click="ClearListButton_Click"/>

            </Grid>


            <Border Grid.Row="2"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                    CornerRadius="8"
                    Padding="1">

                <Grid>

                    <DataGrid x:Name="AudioFilesGrid"
                              ItemsSource="{Binding AudioFiles}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserSortColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              ColumnHeaderHeight="NaN"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              SelectionChanged="AudioFilesGrid_SelectionChanged">

                        <DataGrid.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}">
                                <Setter Property="Padding" Value="4,0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>

                            <DataGridTextColumn x:Name="ArtistColumn"
                                                Header="Artist"
                                                Binding="{Binding Artist}"
                                                Width="0.95*"
                                                MinWidth="85"/>

                            <DataGridTextColumn x:Name="AlbumColumn"
                                                Header="Album"
                                                Binding="{Binding Album}"
                                                Width="0.95*"
                                                MinWidth="85"/>

                            <DataGridTextColumn x:Name="TrackNumberColumn"
                                                Header="#"
                                                Binding="{Binding Track}"
                                                Width="40"
                                                MinWidth="36"
                                                ElementStyle="{StaticResource CenteredCellTextStyle}"/>

                            <DataGridTextColumn x:Name="TitleColumn"
                                                Header="Title"
                                                Binding="{Binding Title}"
                                                Width="2.15*"
                                                MinWidth="150"/>

                            <DataGridTextColumn x:Name="TrackTagDrColumn"
                                                Binding="{Binding TaggedDR}"
                                                Width="68"
                                                MinWidth="58"
                                                ElementStyle="{StaticResource CenteredCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="Track Tag DR"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="TrackDrColumn"
                                                Binding="{Binding DR}"
                                                Width="58"
                                                MinWidth="54"
                                                ElementStyle="{StaticResource CenteredCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="Track DR"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="AlbumTagDrColumn"
                                                Binding="{Binding AlbumDR}"
                                                Width="76"
                                                MinWidth="64"
                                                ElementStyle="{StaticResource CenteredCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="Album Tag DR"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="AlbumDrColumn"
                                                Binding="{Binding CalculatedAlbumDR}"
                                                Width="68"
                                                MinWidth="58"
                                                ElementStyle="{StaticResource CenteredCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="Album DR"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="PeakColumn"
                                                Header="Peak"
                                                Binding="{Binding Peak}"
                                                Width="80"
                                                MinWidth="70"
                                                ElementStyle="{StaticResource RightAlignedCellTextStyle}"/>

                            <DataGridTextColumn x:Name="RmsColumn"
                                                Header="RMS"
                                                Binding="{Binding RMS}"
                                                Width="80"
                                                MinWidth="70"
                                                ElementStyle="{StaticResource RightAlignedCellTextStyle}"/>

                            <DataGridTextColumn x:Name="StatusColumn"
                                                Header="Status"
                                                Binding="{Binding Status}"
                                                Width="90"
                                                MinWidth="75"/>

                        </DataGrid.Columns>

                    </DataGrid>


                    <TextBlock x:Name="DropHint"
                               Text="Drop files or folders here"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="20"
                               Opacity="0.25"
                               IsHitTestVisible="False"/>

                </Grid>

            </Border>


            <Grid Grid.Row="4">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <StackPanel VerticalAlignment="Center">

                    <Grid Margin="0,0,30,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="CollectionStatusText"
                                   Text="0 files • 0 analyzed • 0 errors"
                                   Opacity="0.55"/>

                        <TextBlock x:Name="StatusText"
                                   Grid.Column="1"
                                   Text=""
                                   Margin="16,0,0,0"
                                   HorizontalAlignment="Right"
                                   TextAlignment="Right"
                                   Opacity="0.65"
                                   TextTrimming="CharacterEllipsis"/>

                    </Grid>

                    <ProgressBar x:Name="AnalysisProgress"
                                 Height="5"
                                 Margin="0,8,30,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"/>

                </StackPanel>


                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">

                    <Button x:Name="RemoveTagsButton"
                            Content="Remove DR Tags"
                            Padding="18,10"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="RemoveTagsButton_Click"/>

                    <Button x:Name="WriteTagsButton"
                            Content="Write DR Tags"
                            Padding="18,10"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="WriteTagsButton_Click"/>

                    <Button x:Name="AnalyzeButton"
                            Content="Analyze"
                            Padding="24,10"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            IsEnabled="False"
                            Click="AnalyzeButton_Click"/>

                </StackPanel>

            </Grid>

        </Grid>

    </DockPanel>

</Window>


