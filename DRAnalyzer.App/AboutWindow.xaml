<Window x:Class="DRAnalyzer.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Dynamic Range Analyzer"
        Icon="Assets/app_icon.ico"
        Width="640"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image Source="Assets/app_icon_256.png"
                   Width="88"
                   Height="88"
                   Stretch="Uniform"
                   VerticalAlignment="Top"/>

            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center">

                <TextBlock Text="Dynamic Range Analyzer"
                           FontSize="20"
                           FontWeight="SemiBold"/>

                <TextBlock x:Name="VersionText"
                           Margin="0,4,0,0"
                           Opacity="0.65"/>

                <TextBlock Margin="0,10,0,0"
                           Text="Classic Dynamic Range (DR) analysis for music files."
                           TextWrapping="Wrap"/>

            </StackPanel>

        </Grid>

        <Separator Grid.Row="1"
                   Margin="0,18,0,16"/>

        <StackPanel Grid.Row="2">

            <TextBlock FontWeight="SemiBold"
                       Text="Analysis formats"/>
            <TextBlock Margin="0,3,0,0"
                       Text="FLAC, WAV, MP3, Ogg Vorbis, Opus, M4A/AAC, AIFF/AIF, WMA, APE and WavPack"
                       TextWrapping="Wrap"/>

            <TextBlock Margin="0,14,0,0"
                       FontWeight="SemiBold"
                       Text="DR tag writing / update / removal"/>
            <TextBlock Margin="0,3,0,0"
                       Text="FLAC, Opus, MP3, Ogg Vorbis, M4A, WAV, AIFF/AIF, APE and WavPack"
                       TextWrapping="Wrap"/>

            <TextBlock Margin="0,14,0,0"
                       FontWeight="SemiBold"
                       Text="Metadata safety"/>
            <TextBlock Margin="0,3,0,0"
                       Text="Only DYNAMIC RANGE and ALBUM DYNAMIC RANGE are changed by DR tag operations."
                       TextWrapping="Wrap"/>

            <TextBlock Margin="0,14,0,0"
                       FontWeight="SemiBold"
                       Text="Reference"/>
            <TextBlock Margin="0,3,0,0"
                       Text="DR calculation validated against foo_dr_meter 1.0.8."
                       TextWrapping="Wrap"/>

        </StackPanel>

        <TextBlock Grid.Row="3"
                   Margin="0,18,0,0"
                   Opacity="0.6"
                   Text="Audio decoding and metadata reading: FFmpeg / ffprobe."
                   TextWrapping="Wrap"/>

        <Button Grid.Row="4"
                Content="OK"
                Width="88"
                Padding="12,7"
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                IsDefault="True"
                Click="OkButton_Click"/>

    </Grid>

</Window>
